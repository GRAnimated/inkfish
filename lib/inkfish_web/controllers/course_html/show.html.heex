<h1>
  Course: <%= @course.name %>
</h1>

<%= if is_staff?(@current_reg, @current_user) do %>
  <p>
    <.link href={~p"/staff/courses/#{@course}"}>Staff View</.link>
  </p>
<% end %>

<ul>
  <li>
    <strong>Start date:</strong>
    <%= @course.start_date %>
  </li>
</ul>

<%= if @course.attendance_assignment_id do %>
  <div id="attendance-widget" data-course-id={@course.id}>
    <!-- react component attendance.jsx -->
    <p>Attendance component goes here...</p>
  </div>
<% end %>

<%= for bucket <- @course.buckets do %>
  <h2><%= bucket.name %></h2>
  <table class="table table-striped">
    <thead>
      <tr>
        <th style="width: 25%;">Name</th>
        <th class="d-none d-md-table-cell" style="width: 43%;">Due</th>
        <th style="width: 12%;">&nbsp;</th>
        <th style="width: 10%;">Weight</th>
        <th style="width: 10%;">Score</th>
      </tr>
    </thead>
    <tbody>
      <%= for as <- bucket.assignments, !as.hide do %>
        <tr>
          <td>
            <.link href={~p"/assignments/#{as}"}><%= as.name %></.link>
            <div class="small d-md-none human-date">
              <%= show_timestamp(as.due) %>
            </div>
          </td>
          <td class="d-none d-md-table-cell human-date"><%= show_timestamp(as.due) %></td>
          <td class="asgn-status"><%= get_status(as) %></td>
          <td><%= as.weight %></td>
          <td><%= show_score(@conn, as) %> / <%= as.points %></td>
        </tr>
      <% end %>
      <tr>
        <td>&nbsp;</td>
        <td class="d-none d-md-table-cell">weight = <%= bucket.weight %></td>
        <td>&nbsp;</td>
        <td>Total:</td>
        <td><%= show_score(@totals[bucket.id]) %>%</td>
      </tr>
    </tbody>
  </table>
<% end %>

<h2>Active Teams</h2>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Category</th>
      <th>Members</th>
      <th>Assignments</th>
    </tr>
  </thead>
  <tbody>
    <%= for ts <- Enum.sort_by(@course.teamsets, &(&1.inserted_at)) do %>
      <tr>
        <td><%= ts.name %></td>
        <%= if team = @teams[ts.id] do %>
          <td><%= show_team_members(team) %></td>
        <% else %>
          <td>∅</td>
        <% end %>
        <td><%= show_teamset_assignments(ts) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
