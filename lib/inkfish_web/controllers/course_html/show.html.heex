<h1>
  Course: <%= @course.name %>
</h1>

<%= if is_staff?(@current_reg, @current_user) do %>
  <p>
    <.link href={~p"/staff/courses/#{@course}"}>Staff View</.link>
  </p>
<% end %>

<ul>
  <li>
    <strong>Start date:</strong>
    <%= @course.start_date %>
  </li>
</ul>

<%= if @course.attendance_assignment_id do %>
  <div id="attendance-widget" data-course-id={@course.id}>
    <!-- react component attendance.jsx -->
    <p>Attendance component goes here...</p>
  </div>
<% end %>

<%= for bucket <- @course.buckets do %>
  <!-- desktop -->
  <div class="d-none d-md-block">
    <h2><%= bucket.name %></h2>
    <table class="table table-striped assignments-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Due</th>
          <th>&nbsp;</th>
          <th>Weight</th>
          <th>Score</th>
        </tr>
      </thead>
      <tbody>
        <%= for as <- bucket.assignments, !as.hide do %>
          <tr>
            <td>
              <.link href={~p"/assignments/#{as}"}><%= as.name %></.link>
            </td>
            <td>
              <span class="text-muted small human-date">
                <%= show_timestamp(as.due) %>
              </span>
            </td>
            <td><%= get_status(as) %></td>
            <td><%= as.weight %></td>
            <td><%= show_score(@conn, as) %> / <%= as.points %></td>
          </tr>
        <% end %>
        <tr>
          <td>weight = <%= bucket.weight %></td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td>Total:</td>
          <td><%= show_score(@totals[bucket.id]) %>%</td>
        </tr>
      </tbody>
    </table>
  </div>
  
  <!-- mobile -->
  <div class="d-md-none mt-4">
    <div class="d-flex justify-content-between align-items-center">
      <span class="h2"><%= bucket.name %></span>
      <span>Total Score: <%= show_score(@totals[bucket.id]) %>%</span>
    </div>
    <%= for as <- bucket.assignments, !as.hide do %>
      <.link href={~p"/assignments/#{as}"}>
        <div class="mobile-item">
          <div class="mobile-header">
            <div class="mobile-name">
              <%= as.name %>
            </div>
            <div class="mobile-status">
              <%= get_status(as) %>
            </div>
          </div>
          <div class="assignment-date small human-date">
            <%= show_timestamp(as.due) %>
          </div>
          <div class="mobile-info">
            <div class="mobile-info-item">
              <span class="mobile-label">Weight:</span>
              <span><%= as.weight %></span>
            </div>
            <div class="mobile-info-item">
              <span class="mobile-label">Score:</span>
              <span><%= show_score(@conn, as) %> / <%= as.points %></span>
            </div>
          </div>
        </div>
      </.link>
    <% end %>
  </div>
<% end %>

<h2>Active Teams</h2>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Category</th>
      <th>Members</th>
      <th>Assignments</th>
    </tr>
  </thead>
  <tbody>
    <%= for ts <- Enum.sort_by(@course.teamsets, &(&1.inserted_at)) do %>
      <tr>
        <td><%= ts.name %></td>
        <%= if team = @teams[ts.id] do %>
          <td><%= show_team_members(team) %></td>
        <% else %>
          <td>∅</td>
        <% end %>
        <td><%= show_teamset_assignments(ts) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
